{
	auto_https off
}

:80 {
	encode zstd gzip

	@api path /api/* /connect/* /.well-known/* /mcp /mcp/*
	handle @api {
		reverse_proxy harbor-api:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
