# Copy to /opt/harbor/.env on the server. Mode 0600. Do not commit real values.
# Generate new passwords. Do not reuse .secrets/dev-db.env.

POSTGRES_PASSWORD=
HARBOR_APP_PASSWORD=

# Host name is the compose service harbor-db. User harbor owns the database and runs SQL.
HARBOR_OWNER_CONNECTION=Host=harbor-db;Port=5432;Database=harbor;Username=harbor;Password=

# User harbor_app is the runtime login. The ledger stays insert-only for this role.
HARBOR_APP_CONNECTION=Host=harbor-db;Port=5432;Database=harbor;Username=harbor_app;Password=

# Index 1 replaces the second origin from appsettings.json. Both values are the public origin.
Harbor__Origins__0=https://hr.birbol.com
Harbor__Origins__1=https://hr.birbol.com

# Leave empty when Turnstile is not configured. A secret without a site key blocks registration.
Harbor__TurnstileSecret=
VITE_TURNSTILE_SITE_KEY=

# Leave empty. The API logs the invite path when this value is empty. It does not send mail.
Harbor__MailWorkerUrl=
